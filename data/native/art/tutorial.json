{
 "//": "Entity art for Front Lawn. Keyed <kind>:<id>; `bundle` is a directory under art/, `armature` one of the rigs inside it, and `animations` maps a game state to whatever that rig calls it. Plants, zombies and projectiles are drawn the way PVZGE draws them: every character at its CharacterScale (0.42) times the port's cell-to-square ratio, which is the 0.512 the lawn and mowers use, with the rig's origin - its feet - on the lane's floor, 8 PVZGE units below the square's centre (9.7 here). Sizes therefore come from the art itself, so a peashooter and a sunflower stand as tall as each other as they did in the original. `sockets` names bones the game reads positions off (`armor` is where a cone or bucket sits). `armor:<id>` rigs hang off that socket at the zombie rig's own scale. A mod reskins an entity by shipping a file like this in its own art/ directory.",
 "plant:peashooter": {
  "bundle": "plants_PeashooterPLANT",
  "armature": "Peashooter",
  "scale": 0.512,
  "offset_x": 0,
  "offset_y": 9.7,
  "//": "projectile_origin is the PeashooterPLANT prefab's PeaSpawnPoint, in rig units with y up.",
  "projectile_origin": [66.538, 79.306],
  "//idle": "idle_random is the prefab AnimationController's RandomAnim, played instead of the idle a random_rate/200 of the time (RandRate, 100 when the prefab leaves it out).",
  "idle_random": ["Random"],
  "animations": {
   "idle": "Idle",
   "attack": "Shoot",
   "die": "Death",
   "plantfood": "Food"
  }
 },
 "plant:sunflower": {
  "bundle": "plants_SunflowerPLANT",
  "armature": "Sunflower",
  "scale": 0.512,
  "offset_x": 0,
  "offset_y": 9.7,
  "//": "produce_point is the SunflowerPLANT prefab's SunProducePoint, in rig units with y up; sun_direction is where PVZGE throws the sun: sideways away from the stem's shade, up by the point's height.",
  "produce_point": [-5.9, 109.8],
  "sun_direction": [-11.8, 109.8],
  "idle_random": ["Rand1", "Rand2", "Rand1", "Idle"],
  "animations": {
   "idle": "Idle",
   "attack": "Produce",
   "die": "Death",
   "plantfood": "Food"
  }
 },
 "plant:wallnut": {
  "bundle": "plants_WallnutPLANT",
  "armature": "Wall-nut",
